# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#DATABASE_URL=postgresql://postgres:password@localhost:5432/plant_disease

# JWT signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#JWT_SECRET_KEY=change_me_to_a_long_random_string

# Optional overrides (defaults shown)
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

DATABASE_URL=postgresql://kathyxie@localhost:5432/plant_disease
JWT_SECRET_KEY=<the_generated_hex_string_here>
